# Copy this file to .env and replace values for the target environment.
# Optional Temporal endpoint for the enquiry client and worker; defaults to localhost:7233.
OFTL_AI_TEMPORALURL=localhost:7233
# Optional workflow ID reuse policy; defaults to ALLOW_DUPLICATE.
OFTL_AI_TEMPORALREUSE_POLICY=ALLOW_DUPLICATE
OFTL_OPENAI_URL=http://dev.qwen2.5.openfintechlab.com:8080/v1/chat/completions
OFTL_OPENAI_APITOKEN=replace-me
OFTL_OPENAI_TEMPERATURE=0.1
OFTL_OPENAI_TOP_P=0.9
OFTL_OPENAI_MAX_TOKENS=200
OFTL_OPENAI_TIMEOUT=300
OFTL_OPENAI_STREAM=False
# Required Markdown template for the first AI prompt.
OFTL_AI_PROMPT_1=prompts/customer_enquiry_triage.md
# Required Markdown template for the AI-generated customer response.
OFTL_AI_PROMPT_2=prompts/message-generation/enquiry-message-generator-v1.0.md
OFTL_LOG_LEVEL=INFO
OFTL_LOG_FORMAT=[%(asctime)s] %(levelname)s [%(name)s.%(funcName)s:%(lineno)d] %(message)s
OFTL_IMQ_QMGR=QM1
OFTL_IMQ_CHANNEL=DEV.APP.SVRCONN
OFTL_IMQ_LISTENER=1414
OFTL_IMQ_USERNAME=app
OFTL_IMQ_PASS=replace-me
OFTL_IMQ_HOST=localhost
OFTL_IMQ_REQUEST_QUEUE=AI.CUST.ENQ.TRIAGE.REQUEST.Q
OFTL_IMQ_RESULT_QUEUE=AI.CUST.ENQ.TRIAGE.RESULT.Q
OFTL_IMQ_BACKOUT_QUEUE=AI.CUST.ENQ.TRIAGE.BACKOUT.Q
