# Copy to .env and replace credentials and service addresses.
# Examples target Docker Desktop containers connecting to services on the host.
# For native processes use localhost; for remote services use their actual hostname.
# Process environment overrides .env; docker run -e overrides --env-file values.

# Startup: CLIENT or WORKER. Docker defaults to WORKER.
OFTL_RUN_MODE=WORKER

# Temporal: required service in both modes; endpoint setting defaults to localhost:7233.
# Use host:port (no HTTP path). Current code uses the default namespace without TLS/API keys.
OFTL_AI_TEMPORALURL=host.docker.internal:7233
# CLIENT only; case-insensitive. Default: ALLOW_DUPLICATE.
# Other values: ALLOW_DUPLICATE_FAILED_ONLY, REJECT_DUPLICATE, TERMINATE_IF_RUNNING.
OFTL_AI_TEMPORALREUSE_POLICY=ALLOW_DUPLICATE

# IBM MQ: all six connection settings are required in both modes; no code defaults.
OFTL_IMQ_QMGR=QM1
OFTL_IMQ_CHANNEL=DEV.APP.SVRCONN
OFTL_IMQ_LISTENER=1414
OFTL_IMQ_USERNAME=app
OFTL_IMQ_PASS=replace-me
OFTL_IMQ_HOST=host.docker.internal
# Port must be an integer from 1 to 65535. Queue values below match code defaults.
OFTL_IMQ_REQUEST_QUEUE=AI.CUST.ENQ.TRIAGE.REQUEST.Q
OFTL_IMQ_RESULT_QUEUE=AI.CUST.ENQ.TRIAGE.RESULT.Q
# Reserved setting; backout publication is not implemented.
OFTL_IMQ_BACKOUT_QUEUE=AI.CUST.ENQ.TRIAGE.BACKOUT.Q

# AI: URL and token required for WORKER processing; not used by CLIENT.
# Supply an OpenAI-compatible base URL or full /chat/completions URL.
# The endpoint must support the application's fixed model name: default.
OFTL_OPENAI_URL=http://host.docker.internal:8080/v1/chat/completions
OFTL_OPENAI_APITOKEN=replace-me
# Optional settings below use code defaults. Temperature: 0..2; top_p: 0..1.
OFTL_OPENAI_TEMPERATURE=0.1
OFTL_OPENAI_TOP_P=0.9
# Positive integers; timeout is per HTTP request in seconds.
OFTL_OPENAI_MAX_TOKENS=200
OFTL_OPENAI_TIMEOUT=300
# Only true/false (case-insensitive); 1/0 and yes/no are not accepted.
OFTL_OPENAI_STREAM=False

# WORKER: required template paths, relative to the process working directory.
# v04 accepts MESSAGE and CATEGORY, and requests product_code and emotionalType.
OFTL_AI_PROMPT_1=prompts/customer_enquiry_triage_v04.md
OFTL_AI_PROMPT_2=prompts/message-generation/enquiry-message-generator-v1.0.md

# Optional logging; these values match code defaults.
# Standard levels: DEBUG, INFO, WARNING, ERROR, CRITICAL. Unknown names fall back to INFO.
# DEBUG can expose MQ credentials, prompts, and customer/model content in current code.
OFTL_LOG_LEVEL=INFO
OFTL_LOG_FORMAT=[%(asctime)s] %(levelname)s [%(name)s.%(funcName)s:%(lineno)d] %(message)s
